# Local development uses PGlite when DATABASE_URL is empty.
DATABASE_URL=

# REQUIRED for encrypted staff fields. Generate your own 64-character hex key:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep an existing deployment's key unchanged.
DATA_ENCRYPTION_KEY=

# Optional: AI agreement extraction / documentation features.
ANTHROPIC_API_KEY=

# Text messages to clients (signing codes). Leave unset to keep texting off.
# Twilio needs a Business Associate Agreement before any real client is texted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Shared secret for the scheduled jobs in vercel.json. Generate: openssl rand -hex 32
CRON_SECRET=
