# Copy to .env.local for local development. On Vercel, set these under Project Settings > Environment Variables.

# Hosted Postgres connection string (Neon, Supabase, RDS). Leave unset locally to use the embedded PGlite database in ./data/pglite.
DATABASE_URL=

# 64 hex characters. Encrypts staff SSNs at rest. Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# Optional. Enables AI extraction of service agreement PDFs.
ANTHROPIC_API_KEY=
# Only needed when the key is tied to a specific workspace.
ANTHROPIC_WORKSPACE_ID=
