# Local development uses PGlite when DATABASE_URL is empty.
DATABASE_URL=

# REQUIRED for encrypted staff fields. Generate your own 64-character hex key:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep an existing deployment's key unchanged.
DATA_ENCRYPTION_KEY=

# Optional: AI agreement extraction / documentation features.
ANTHROPIC_API_KEY=

# Text messages to clients (signing codes). Leave unset to keep texting off.
# Twilio needs a Business Associate Agreement before any real client is texted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Shared secret for the scheduled jobs in vercel.json. Generate: openssl rand -hex 32
CRON_SECRET=

# Set to 1 to make the app ask for a password. Unset, the deployment opens straight into the
# dashboard as the first admin — fine for a demo, a breach the day a real client is entered.
REQUIRE_LOGIN=1

# ---------- Electronic Visit Verification ----------
# Which aggregator adapter drains the EVV queue: "mock" (default; never leaves the server) or
# "hhax_mn" (Minnesota HHAeXchange). Production submission also needs EVV_SUBMISSION_ENABLED=1 and
# the provider profile's "production enabled" switch; with anything missing the adapter fails
# closed and submissions sit in "blocked".
EVV_AGGREGATOR_ADAPTER=mock
EVV_SUBMISSION_ENABLED=0
# HHAeXchange connection. Every value comes from DHS/HHAX onboarding — none is a public default.
HHAX_ENVIRONMENT=off
HHAX_BASE_URL=
HHAX_VISIT_PATH=
HHAX_ACK_PATH=
HHAX_CLIENT_ID=
HHAX_PROVIDER_ID=
HHAX_CLIENT_SECRET=
HHAX_TIMEOUT_MS=15000
