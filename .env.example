# Required for "Upload service agreement" AI extraction. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Only if your key is "identity-linked" to a workspace (the API says so). Console → Settings → Workspaces, id starts with wrkspc_.
ANTHROPIC_WORKSPACE_ID=

# 32 random bytes as hex. Encrypts staff SSNs at rest. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Losing this key makes stored SSNs unreadable.
DATA_ENCRYPTION_KEY=
